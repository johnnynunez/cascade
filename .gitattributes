# Binary geometry/model payloads: LFS.
*.pt filter=lfs diff=lfs merge=lfs -text
*.STL filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.usd filter=lfs diff=lfs merge=lfs -text
assets/**/Textures/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/Textures/*.jpg filter=lfs diff=lfs merge=lfs -text

# .usda/.usdc are ASCII USD scene-graph text, NOT geometry payloads --
# src/cascade/control/usd_model.py's _find_physics_layer() parses them
# directly as text to find PhysicsJoint prims (following sublayer/
# reference/payload paths breadth-first). They must stay real git blobs:
# CI's actions/checkout does not fetch LFS content by default, and an
# LFS-pointer .usda breaks every USD/kinematics test with "no PhysicsJoint
# prims reachable" (see the 2026-08-27 CI incident this comment documents).
*.usda -filter -diff -merge text
*.usdc -filter -diff -merge text
