# reBot RS: original URDF joint convention (q_asset = -q_local).
# Adapted from the existing Cascade collision-sphere model; see PROVENANCE.md.
# Static finger opening 0.026 m; live observed geometry retains authority.
format: xrdf
format_version: 2.0
default_joint_positions: {joint1: -0.0, joint2: -1.2, joint3: -1.2, joint4: -0.0, joint5: -0.0, joint6: -0.0, joint_left: 0.026,
  joint_right: 0.026}
cspace:
  joint_names: [joint1, joint2, joint3, joint4, joint5, joint6]
  acceleration_limits: [3.0, 3.0, 3.0, 3.0, 3.0, 3.0]
  jerk_limits: [30.0, 30.0, 30.0, 30.0, 30.0, 30.0]
tool_frames: [gripper_end]
world_collision: {geometry: rebot_collision_spheres}
self_collision:
  geometry: rebot_self_collision_spheres
  ignore:
    base_link: [link1, link2]
    link1: [link2]
    link2: [link3]
    link3: [link4, link5]
    link4: [link5, link6, gripper_end]
    link5: [link6, gripper_end]
    link6: [gripper_end]
    gripper_end: [gripper_left, gripper_right]
    gripper_left: [gripper_right]
geometry:
  rebot_collision_spheres:
    spheres:
