#usda 1.0
(
    defaultPrim = "Presenter"
    framesPerSecond = 60
    metersPerUnit = 1
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "Presenter"
{
    float3 xformOp:rotateXYZ = (0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

    def Scope "Looks"
    {
        def Material "Clothing"
        {
            token outputs:surface.connect = </Presenter/Looks/Clothing/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.28, 0.28, 0.28)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "Head"
        {
            token outputs:surface.connect = </Presenter/Looks/Head/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.55, 0.55)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Xform "Pelvis"
    {
        float3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.98)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

        def Capsule "Torso" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            float3[] extent = [(-0.16, -0.16, -0.385), (0.16, 0.16, 0.385)]
            double height = 0.45
            rel material:binding = </Presenter/Looks/Clothing>
            double radius = 0.16
