            def Sphere "Head" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                float3[] extent = [(-0.11, -0.11, -0.11), (0.11, 0.11, 0.11)]
                rel material:binding = </Presenter/Looks/Head>
                double radius = 0.11
