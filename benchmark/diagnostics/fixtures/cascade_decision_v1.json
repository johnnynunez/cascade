{
  "schema_version": 1,
  "description": "32 handwritten, synthetic Cascade routing situations (16 English, 16 Spanish). Development pilot fixed before inference; no physical trials or calibration claim. Expected labels are local scoring data, never part of the request.",
  "criteria": {
    "get_observation": "Capture a fresh camera frame and refresh object tracking before reasoning from stale, missing, or unverified observations.",
    "localize_object": "Measure the base-frame position of an identified visible object from camera depth without moving the arm.",
    "preview_grasp": "Plan and report a named object's grasp without moving the robot.",
    "grasp_object": "Grasp and hold an identified object when the user requested only a grasp and the prerequisite observations are available.",
    "pick_and_place": "Pick up an identified object and deliver it to an unambiguous destination when current observations support the action.",
    "place_at": "Place the already held object at known base-frame coordinates in meters.",
    "halt_motion": "Cancel the active robot motion after a stop request or a reported dangerous condition.",
    "move_home": "Return an empty arm to its home configuration when requested and no unresolved motion fault is present.",
    "reset_scene": "Reset the Isaac simulation scene after an explicit reset request; this is not a memory lookup.",
    "task_done": "Report completion only when independent current evidence verifies the whole requested goal.",
    "defer_to_planner": "Do not dispatch a skill. Request clarification or further planning when the target is ambiguous, required parameters are missing, or a stopped failed action has no approved recovery. This is an experimental abstention label, not a Cascade tool."
  },
  "cases": [
