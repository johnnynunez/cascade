{
  "id": "cascade-franka-prompt",
  "name": "CASCADE Franka commands",
  "description": "Dispatch explicit operator commands through native Franka tools and scope Cosmos observations to this workspace.",
  "activation": {"onStartup": true},
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["workspaceDir", "modelProviderId", "modelId"],
    "properties": {
      "workspaceDir": {"type": "string", "minLength": 1},
      "modelProviderId": {"type": "string", "minLength": 1},
      "modelId": {"type": "string", "minLength": 1}
    }
  }
}
