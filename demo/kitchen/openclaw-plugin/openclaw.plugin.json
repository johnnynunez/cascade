{
  "id": "cascade-kitchen-prompt",
  "name": "CASCADE kitchen prompt",
  "description": "Present natural English kitchen requests to the local model with high-level native tools.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "workspaceDir",
      "modelProviderId",
      "modelId"
    ],
    "properties": {
      "workspaceDir": {
        "type": "string",
        "minLength": 1
      },
      "modelProviderId": {
        "type": "string",
        "minLength": 1
      },
      "modelId": {
        "type": "string",
        "minLength": 1
      },
      "mcpName": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
