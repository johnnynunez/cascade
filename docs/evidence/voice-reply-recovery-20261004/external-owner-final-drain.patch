+"""CPU lifecycle regression: empty cgroup/launcher exit precedes final reap."""
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+import importlib.util
+import os
+import signal
+import subprocess
+import sys
+import threading
+import time
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('recovered_owned_services', HERE / 'owned_services.py')
+owned = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(owned)
+
+
+def test_final_observed_birth_is_joined_after_scope_members_disappear(tmp_path):
+    child = subprocess.Popen([sys.executable, '-c', 'pass'])
+    peer = subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(20)'])
+    expected = owned.birth(child.pid)
+    reaped = threading.Event()
+    scope = owned.OwnedScope('test', ['unused'], cwd=tmp_path, env=os.environ,
+        out=tmp_path / 'scope', timeout_s=10, target='unused')
+    scope.out.mkdir()
+    scope.process = SimpleNamespace(wait=lambda **_: 0)
+    scope.invocation, scope.cgroup = 'ours', '/fixture-empty'
+    scope.observed[(child.pid, expected['start_ticks'])] = expected
+    active = {'ActiveState': 'active', 'InvocationID': 'ours',
+              'Description': scope.description, 'ControlGroup': scope.cgroup}
+    def state(_, **unused):
+        return {'ActiveState': 'inactive'} if reaped.is_set() else active
+    def finish_reaping():
+        # Keep a genuine observed process birth alive after the fake cgroup is
+        # empty. No PID/clock mocking hides the lifecycle race being checked.
+        time.sleep(.2)
+        child.wait(timeout=2)
+        reaped.set()
+    thread = threading.Thread(target=finish_reaping)
+    thread.start()
+    try:
+        with patch.object(scope, 'members', return_value=[]), patch.object(owned, 'unit_state', side_effect=state), patch.object(owned, 'signal_birth') as send:
+            result = scope.close()
+        assert result['ok'] and result['final_drain']['settled']
+        assert result['final_drain']['waited_s'] >= .15
+        assert result['remaining_births'] == [] and result['state']['ActiveState'] == 'inactive'
+        assert not result['forced'] and not result['signals']
+        send.assert_not_called()
+        assert peer.poll() is None
+    finally:
+        thread.join(3)
+        if child.poll() is None:
+            child.terminate()
+        child.wait(2)
+        owned.signal_birth(owned.birth(peer.pid), signal.SIGTERM)
+        peer.wait(2)
+
+
+def test_final_drain_remains_bounded_when_unit_never_closes(tmp_path):
+    scope = owned.OwnedScope('test', ['unused'], cwd=tmp_path, env=os.environ,
+        out=tmp_path / 'scope', timeout_s=10, target='unused')
+    scope.out.mkdir()
+    scope.process = SimpleNamespace(wait=lambda **_: 0)
+    scope.invocation, scope.cgroup = 'ours', '/fixture-empty'
+    active = {'ActiveState': 'active', 'InvocationID': 'ours',
+              'Description': scope.description, 'ControlGroup': scope.cgroup}
+    calls = 0
+    def clock():
+        nonlocal calls
+        calls += 1
+        return 0. if calls < 4 else 11.
+    with patch.object(scope, 'members', return_value=[]), patch.object(owned, 'unit_state', return_value=active), patch.object(owned.time, 'monotonic', side_effect=clock), patch.object(owned, 'signal_birth') as send:
+        result = scope.close()
+    assert not result['ok'] and not result['final_drain']['settled']
+    assert result['state']['ActiveState'] == 'active'
+    send.assert_not_called()
