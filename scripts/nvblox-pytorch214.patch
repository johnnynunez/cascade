diff --git a/cmake/cuda/setup_compute_capability.cmake b/cmake/cuda/setup_compute_capability.cmake
index 50bbc36..d672263 100644
--- a/cmake/cuda/setup_compute_capability.cmake
+++ b/cmake/cuda/setup_compute_capability.cmake
@@ -50,21 +50,10 @@ set(TORCH_CUDA_ARCH_LIST "")
 # Loop through each number in the list
 foreach(ARCH IN LISTS CMAKE_CUDA_ARCHITECTURES)
 
-  # The numbers can be 2-3 digits, e.g. 90 -> 9.0 or 120 -> 1.20
-  string(LENGTH "${ARCH}" num_digits)
-
-  string(SUBSTRING "${ARCH}" 0 1 FIRST_DIGIT)
-  string(SUBSTRING "${ARCH}" 1 1 SECOND_DIGIT)
-  if(num_digits EQUAL 2)
-    set(DOT_SEPARATED "${FIRST_DIGIT}.${SECOND_DIGIT}")
-  else()
-    # Currently, Caffe2 only support Cuda architectues up to 9.0
-    message(
-      WARNING
-        "Cuda architecture ${ARCH} not supported for nvblox_torch. Reverting to 9.0 and hoping for backward compatibility"
-    )
-    set(DOT_SEPARATED "9.0")
-  endif()
+  # PyTorch 2.14 supports Blackwell: 120 -> 12.0, 121 -> 12.1.
+  math(EXPR ARCH_MAJOR "${ARCH} / 10")
+  math(EXPR ARCH_MINOR "${ARCH} % 10")
+  set(DOT_SEPARATED "${ARCH_MAJOR}.${ARCH_MINOR}")
   # Append to the result list
   list(APPEND TORCH_CUDA_ARCH_LIST "${DOT_SEPARATED}")
 endforeach()
diff --git a/cmake/nvblox_targets.cmake b/cmake/nvblox_targets.cmake
index 90065a4..e19fc5e 100644
--- a/cmake/nvblox_targets.cmake
+++ b/cmake/nvblox_targets.cmake
@@ -54,8 +54,13 @@ function(set_nvblox_compiler_options_internal target_name enable_warnings)
   # they are distributed.
   set_target_properties(${target_name} PROPERTIES BUILD_RPATH_USE_ORIGIN on)
 
-  # c++17 compilation. We use c++17 features.
-  add_host_compiler_option(${target_name} "-std=gnu++17")
+  # PyTorch 2.14 requires C++20 for its wrapper headers.
+  if(target_name MATCHES "^py_nvblox")
+    set_target_properties(${target_name} PROPERTIES CXX_STANDARD 20 CUDA_STANDARD 20)
+    add_host_compiler_option(${target_name} "-std=gnu++20")
+  else()
+    add_host_compiler_option(${target_name} "-std=gnu++17")
+  endif()
 
   # ############################################################################
   # PREPROCESSOR DIRECTIVES
diff --git a/nvblox_torch/cpp/CMakeLists.txt b/nvblox_torch/cpp/CMakeLists.txt
index b7228a6..e7a02f6 100644
--- a/nvblox_torch/cpp/CMakeLists.txt
+++ b/nvblox_torch/cpp/CMakeLists.txt
@@ -16,7 +16,10 @@ set(CMAKE_CUDA_ARCHITECTURES ${CMAKE_CUDA_ARCHITECTURES_OLD})
 
 # On Jetson, we need to link explicitly against cudnn
 if(CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64")
-  list(APPEND TORCH_LIBRARIES cudnn)
+  # pip CUDA wheels carry a versioned library, not a system -lcudnn symlink.
+  find_library(NVBLOX_CUDNN_LIBRARY NAMES cudnn libcudnn.so.9
+    HINTS "${TORCH_INSTALL_PREFIX}/../nvidia/cudnn/lib" REQUIRED)
+  list(APPEND TORCH_LIBRARIES ${NVBLOX_CUDNN_LIBRARY})
 endif()
 
